# CampusCart Environment Configuration
PORT=3000

# Optional Supabase Integration
# If provided, CampusCart can bridge to live Supabase PostgreSQL and Auth.
# If omitted, CampusCart runs flawlessly with its built-in SQLite engine and Real-Time SSE event bus!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
